{
	"schema_version": 1,
	"id": "claude_code_local_v1",
	"description": "Local Claude Code in print mode as a tool-less completion backend (JSON fallback path); the scaffold, budgets, and logging stay in the runner.",
	"provider": {
		"kind": "command",
		"preset": "claude_code",
		"model": "claude-opus-5",
		"effort": "high",
		"timeout_s": 600
	},
	"sampling": {"temperature": null},
	"budgets": {
		"model_requests_per_decision": 4,
		"output_tokens_per_decision": 8000,
		"episode_tokens": 400000,
		"episode_cost_usd": 5.0
	},
	"pricing_usd_per_million": {"input": 5.0, "output": 25.0, "cache_read": 0.5, "cache_write": 6.25},
	"notes": {"max_chars": 4000},
	"tool_result_max_chars": 24000,
	"retry": {"max_attempts": 2, "backoff_s": 5.0}
}
